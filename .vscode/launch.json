    "version": "0.2.0",
    "configurations": [
        {
            "name": "ChirographSample: Rockets.Console",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/sample/ChirographSample/Rockets.Console/bin/Debug/net10.0/Rockets.Console.dll",
            "args": [],
            "cwd": "${workspaceFolder}/sample/ChirographSample/Rockets.Console",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "justMyCode": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
