<Project>
  <!--
      A package Chirograph adds to a project is declared as one private item, which becomes a PackageReference here:

          <_ChirographImplicitPackageReference Include="Microsoft.Kiota.Bundle" Version="$(ChirographKiotaBundleVersion)" />

      Every metadata value (PrivateAssets, IncludeAssets, ...) is copied onto the PackageReference. The expansion happens at evaluation,
      not in a target, because NuGet restore only sees the items that exist when evaluation finishes. It only sees the items declared
      before it, so Sdk.targets imports this file last.

      A package the project references itself wins: its own PackageReference, and its version, are left alone, and nothing is added.

      Under Central Package Management (ManagePackageVersionsCentrally), a package with a PackageVersion gets a plain PackageReference,
      with no Version and not implicitly defined, so the central version wins: NuGet rejects an implicitly defined reference to a package
      that has a PackageVersion (NU1009). A package without a PackageVersion keeps the implicit reference with Chirograph's version, which
      NuGet allows under Central Package Management.
  -->
  <ItemGroup>
    <!--
        Exclude drops the packages the project references itself (item identities compare case-insensitively). Dovetail's
        DovetailSdkImplicitPackageReference uses a condition on %(Identity) instead, which evaluation doesn't batch: it added a second
        PackageReference next to the project's own.
    -->
    <_ChirographImplicitPackageReferenceToAdd Include="@(_ChirographImplicitPackageReference)" Exclude="@(PackageReference)" />

    <!-- The packages Central Package Management pins: those to add, less those without a PackageVersion. -->
    <_ChirographImplicitPackageReferenceUnpinned Include="@(_ChirographImplicitPackageReferenceToAdd)" Exclude="@(PackageVersion)" />
    <_ChirographImplicitPackageReferencePinned
      Include="@(_ChirographImplicitPackageReferenceToAdd)"
      Exclude="@(_ChirographImplicitPackageReferenceUnpinned)"
      Condition="'$(ManagePackageVersionsCentrally)' == 'true'"
    />
    <_ChirographImplicitPackageReferenceToAdd Remove="@(_ChirographImplicitPackageReferencePinned)" />

    <PackageReference Include="@(_ChirographImplicitPackageReferenceToAdd)" IsImplicitlyDefined="true" />
    <PackageReference Include="@(_ChirographImplicitPackageReferencePinned)" Version="" />

    <_ChirographImplicitPackageReferenceToAdd Remove="@(_ChirographImplicitPackageReferenceToAdd)" />
    <_ChirographImplicitPackageReferenceUnpinned Remove="@(_ChirographImplicitPackageReferenceUnpinned)" />
    <_ChirographImplicitPackageReferencePinned Remove="@(_ChirographImplicitPackageReferencePinned)" />
  </ItemGroup>
</Project>
