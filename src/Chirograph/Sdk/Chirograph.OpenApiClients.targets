<Project>
  <!--
      HTTP clients generated from OpenAPI documents, imported by Sdk.targets (during evaluation, after the whole project, so it sees the
      project's OpenApiClient items). A project declares a client with an item:

          <OpenApiClient Include="openapi/rockets.yaml" Generator="Refitter" ClientName="RocketsClient" Namespace="MyApp.Rockets" />

      The Include is where the OpenAPI document comes from:
        - a project (.csproj, .fsproj or .vbproj): the document the project writes when it builds. The project becomes a reference of
          the client project that is built first, but not referenced by its assembly.
        - a URL (http:// or https://): downloaded on every build into a cache, obj unless DocumentCache names a file in the project
          (which can be committed). When the download fails, the cache is used with a warning, so a build without the network still works
          once the document has been downloaded. UpdateDocumentCache set to false uses the cache whenever it exists and downloads only
          when it doesn't, which protects the client from a breaking change of the API until the cache is updated on purpose.
        - otherwise a file (.json, .yaml or .yml), relative to the project.

      Metadata:
        - Generator (required): Kiota or Refitter.
        - ClientName (required): the name of the client. Kiota's client class is called this, Refitter's interface is I<ClientName>, the
          extension that registers it is Add<ClientName>(), and its base address is read from Clients:<ClientName>:BaseAddress.
        - Namespace: the namespace of the generated code, $(RootNamespace) when not set.
        - DocumentCache: for a URL, the file the downloaded document is kept in, relative to the project (obj when not set).
        - UpdateDocumentCache: for a URL, false to use the cached document when there is one instead of downloading it again;
          ChirographUpdateOpenApiDocumentCache sets it for every client (true by default).
        - Options: more arguments for the generator's command line (kiota generate, or refitter after its settings file).
        - DocumentName (a project): the document the client is generated from, when the project writes several (v1 is ASP.NET Core's
          default).

      Each generator is a .NET tool package (Microsoft.OpenApi.Kiota, Refitter), which restore downloads (PackageDownload) and the build
      runs from the packages folder: nothing is installed, and a file source needs no network once the packages are restored. The packages
      the generated code needs are added to the project: Microsoft.Kiota.Bundle and Microsoft.Extensions.Http (for the IHttpClientFactory
      registration) for Kiota, and Refit.HttpClientFactory, which brings Microsoft.Extensions.Http, for Refitter.

      Generation is incremental: the document is copied into obj only when its content changes, and a client is generated again only when
      that copy or its settings (generator, its version, ClientName, Namespace, Options) change. The generated code is in
      $(ChirographOpenApiClientsDirectory)<ClientName>/, with <ClientName>ServiceCollectionExtensions.g.cs, the registration, next to it.

      With Dovetail, each client also gets a joint that calls the registration, so a host built with ConfigureDovetail() resolves the client
      with no registration call. Chirograph doesn't write it: it declares a DovetailTemplate item, Chirograph.<ClientName>, which Dovetail
      expands from templates/OpenApiClientJoint.cs.template in the projects that run its generator. The items are declared only when the
      Dovetail in the build sets DovetailTemplateMetadataTokens (it replaces every metadata value of a template, which an older Dovetail
      doesn't), and ChirographGenerateDovetailJoint=false turns them off.
  -->

  <PropertyGroup>
    <!-- the default of UpdateDocumentCache: whether a URL is downloaded again when its document is cached -->
    <ChirographUpdateOpenApiDocumentCache Condition="'$(ChirographUpdateOpenApiDocumentCache)' == ''">true</ChirographUpdateOpenApiDocumentCache>
    <!-- whether each client gets a Dovetail joint, when the Dovetail in the build can write it -->
    <ChirographGenerateDovetailJoint Condition="'$(ChirographGenerateDovetailJoint)' == ''">true</ChirographGenerateDovetailJoint>
    <!-- the folder of the tool packages that holds the tools, which run on .NET 10 or later -->
    <_ChirographOpenApiToolFramework>net10.0</_ChirographOpenApiToolFramework>
    <!-- the reference page of the diagnostics, each error and warning links to the heading of its code -->
    <_ChirographDiagnosticsUrl>https://rocketsurgeonsguild.github.io/Chirograph/reference/diagnostics/</_ChirographDiagnosticsUrl>
  </PropertyGroup>

  <ItemGroup Condition="'@(OpenApiClient)' != ''">
    <_ChirographOpenApiClientServer Include="@(OpenApiClient->WithMetadataValue('Extension', '.csproj'))" />
    <_ChirographOpenApiClientServer Include="@(OpenApiClient->WithMetadataValue('Extension', '.fsproj'))" />
    <_ChirographOpenApiClientServer Include="@(OpenApiClient->WithMetadataValue('Extension', '.vbproj'))" />
    <!--
        The server is built before the client project, as a whole: a server with several target frameworks writes its document from its
        outer build, which SkipGetTargetFrameworkProperties builds instead of the target framework closest to the client's.
    -->
    <ProjectReference
      Include="@(_ChirographOpenApiClientServer->'%(Identity)')"
      ReferenceOutputAssembly="false"
      SkipGetTargetFrameworkProperties="true"
      Private="false"
      PrivateAssets="all"
      ChirographOpenApiClientServer="true"
    />
  </ItemGroup>

  <!--
      One Dovetail joint per client, expanded by Dovetail (Joinery.Dovetail.Templates.targets): every metadata value replaces its
      __Name__ token in the template. The Include is prefixed so it can't clash with another package's template of the same name, and
      names the file Dovetail writes, DovetailTemplate.Chirograph.<ClientName>.g.cs. DovetailTemplateMetadataTokens comes from
      Joinery.Dovetail.props, which a package reference imports before this file.
  -->
  <ItemGroup Condition="'@(OpenApiClient)' != '' and '$(DovetailTemplateMetadataTokens)' == 'true' and '$(ChirographGenerateDovetailJoint)' == 'true'">
    <!-- The client's metadata comes along (ClientName, Namespace, Generator, ...): only __ClientName__ and __Namespace__ are used. -->
    <DovetailTemplate Include="@(OpenApiClient->'Chirograph.%(ClientName)')">
      <File>$(MSBuildThisFileDirectory)templates/OpenApiClientJoint.cs.template</File>
      <Namespace Condition="'%(Namespace)' == ''">$(RootNamespace)</Namespace>
      <ChirographVersion>$(ChirographVersion)</ChirographVersion>
    </DovetailTemplate>
  </ItemGroup>

  <!-- The generators, when a client uses them, at the versions the SDK was packed with. -->
  <ItemGroup Condition="'@(OpenApiClient)' != ''">
    <PackageDownload
      Include="Microsoft.OpenApi.Kiota"
      Version="[$(ChirographKiotaVersion)]"
      Condition="'$(ChirographKiotaVersion)' != '' and @(OpenApiClient->AnyHaveMetadataValue('Generator', 'Kiota')) == 'true'"
    />
    <PackageDownload
      Include="Refitter"
      Version="[$(ChirographRefitterVersion)]"
      Condition="'$(ChirographRefitterVersion)' != '' and @(OpenApiClient->AnyHaveMetadataValue('Generator', 'Refitter')) == 'true'"
    />
    <_ChirographImplicitPackageReference
      Include="Microsoft.Kiota.Bundle"
      Version="$(ChirographKiotaBundleVersion)"
      Condition="'$(ChirographKiotaBundleVersion)' != '' and @(OpenApiClient->AnyHaveMetadataValue('Generator', 'Kiota')) == 'true'"
    />
    <_ChirographImplicitPackageReference
      Include="Refit.HttpClientFactory"
      Version="$(ChirographRefitVersion)"
      Condition="'$(ChirographRefitVersion)' != '' and @(OpenApiClient->AnyHaveMetadataValue('Generator', 'Refitter')) == 'true'"
    />
    <!--
        Not with a Refitter client: Refit.HttpClientFactory brings Microsoft.Extensions.Http itself, at a version that can be newer than
        the one packed here (NU1605, a downgrade, on net11.0).
    -->
    <_ChirographImplicitPackageReference
      Include="Microsoft.Extensions.Http"
      Version="$(ChirographMicrosoftExtensionsHttpVersion)"
      Condition="'$(ChirographMicrosoftExtensionsHttpVersion)' != '' and @(OpenApiClient->AnyHaveMetadataValue('Generator', 'Kiota')) == 'true' and @(OpenApiClient->AnyHaveMetadataValue('Generator', 'Refitter')) != 'true'"
    />
  </ItemGroup>

  <!--
      Generates every client that is out of date and adds the generated code to the compilation. A design-time build only adds what an
      earlier build generated. The hook to run something before or after the clients are generated.
  -->
  <Target
    Name="ChirographGenerateOpenApiClients"
    BeforeTargets="CoreCompile;BeforeCompile"
    AfterTargets="ResolveProjectReferences"
    DependsOnTargets="_ChirographGenerateOpenApiClients;_ChirographCompileOpenApiClients"
    Condition="'@(OpenApiClient)' != ''"
  />

  <Target
    Name="_ChirographGenerateOpenApiClients"
    DependsOnTargets="_ChirographPrepareOpenApiClients;_ChirographResolveOpenApiClientDocuments;_ChirographWriteOpenApiClientSettings;_ChirographRunOpenApiClientGenerators"
    Condition="'$(DesignTimeBuild)' != 'true'"
  />

  <!-- Checks each client and decides where its files go. -->
  <Target Name="_ChirographPrepareOpenApiClients">
    <!-- read here rather than when the project is evaluated, so the file can be imported before IntermediateOutputPath is set -->
    <PropertyGroup>
      <ChirographOpenApiClientsDirectory Condition="'$(ChirographOpenApiClientsDirectory)' == ''">$(IntermediateOutputPath)openapi/</ChirographOpenApiClientsDirectory>
    </PropertyGroup>
    <Error
      Condition="'%(OpenApiClient.Generator)' != 'Kiota' and '%(OpenApiClient.Generator)' != 'Refitter'"
      Code="CHIRO100"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro100"
      Text="The OpenApiClient '%(OpenApiClient.Identity)' has Generator '%(OpenApiClient.Generator)': set it to Kiota or Refitter."
    />
    <Error
      Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(OpenApiClient.ClientName)', '^[A-Za-z_][A-Za-z0-9_]*$'))"
      Code="CHIRO101"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro101"
      Text="The OpenApiClient '%(OpenApiClient.Identity)' has ClientName '%(OpenApiClient.ClientName)': set it to the name of the client, a C# identifier."
    />

    <ItemGroup>
      <_ChirographOpenApiClient Remove="@(_ChirographOpenApiClient)" />
      <_ChirographOpenApiClient Include="@(OpenApiClient)">
        <Kind>File</Kind>
        <Kind Condition="'%(Extension)' == '.csproj' or '%(Extension)' == '.fsproj' or '%(Extension)' == '.vbproj'">Project</Kind>
        <Kind Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)^https?://'))">Url</Kind>
      </_ChirographOpenApiClient>
      <_ChirographOpenApiClient>
        <Source Condition="'%(_ChirographOpenApiClient.Kind)' == 'File'">%(_ChirographOpenApiClient.FullPath)</Source>
        <Namespace Condition="'%(_ChirographOpenApiClient.Namespace)' == ''">$(RootNamespace)</Namespace>
        <ClientDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(ChirographOpenApiClientsDirectory)', '%(_ChirographOpenApiClient.ClientName)'))</ClientDirectory>
        <!-- the document keeps the extension of its source, which tells the generators JSON from YAML -->
        <DocumentExtension>.json</DocumentExtension>
        <DocumentExtension Condition="'%(_ChirographOpenApiClient.Kind)' != 'Project' and ('%(_ChirographOpenApiClient.Extension)' == '.yaml' or '%(_ChirographOpenApiClient.Extension)' == '.yml')">%(_ChirographOpenApiClient.Extension)</DocumentExtension>
      </_ChirographOpenApiClient>
      <_ChirographOpenApiClient>
        <GeneratedDirectory>%(_ChirographOpenApiClient.ClientDirectory)generated/</GeneratedDirectory>
        <SettingsFile>%(_ChirographOpenApiClient.ClientDirectory)settings.txt</SettingsFile>
        <RegistrationFile>%(_ChirographOpenApiClient.ClientDirectory)%(_ChirographOpenApiClient.ClientName)ServiceCollectionExtensions.g.cs</RegistrationFile>
        <StampFile>%(_ChirographOpenApiClient.ClientDirectory)generated.stamp</StampFile>
        <RefitterSettingsFile>%(_ChirographOpenApiClient.ClientDirectory)%(_ChirographOpenApiClient.ClientName).refitter</RefitterSettingsFile>
        <Document>%(_ChirographOpenApiClient.ClientDirectory)openapi%(_ChirographOpenApiClient.DocumentExtension)</Document>
      </_ChirographOpenApiClient>
    </ItemGroup>

    <Error
      Condition="'%(_ChirographOpenApiClient.Kind)' == 'File' and !Exists('%(_ChirographOpenApiClient.Source)')"
      Code="CHIRO102"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro102"
      Text="The OpenAPI document '%(_ChirographOpenApiClient.Identity)' of the OpenApiClient '%(_ChirographOpenApiClient.ClientName)' does not exist."
    />
    <MakeDir Directories="@(_ChirographOpenApiClient->'%(ClientDirectory)')" />
  </Target>

  <!--
      Finds the source document of each client (a file is its own source, a server project is asked for the documents it wrote, and a
      URL is downloaded into its cache), and copies it to the client's folder when its content differs from the copy there, so a document
      that was written again unchanged regenerates nothing. Batched on each client, by name: two clients can be generated from the same
      document.
  -->
  <Target Name="_ChirographResolveOpenApiClientDocuments" Outputs="%(_ChirographOpenApiClient.ClientName)">
    <PropertyGroup>
      <_ChirographOpenApiKind>%(_ChirographOpenApiClient.Kind)</_ChirographOpenApiKind>
      <_ChirographOpenApiSource>%(_ChirographOpenApiClient.Source)</_ChirographOpenApiSource>
      <_ChirographOpenApiDocument>%(_ChirographOpenApiClient.Document)</_ChirographOpenApiDocument>
      <_ChirographOpenApiClientName>%(_ChirographOpenApiClient.ClientName)</_ChirographOpenApiClientName>
      <_ChirographOpenApiDocumentName>%(_ChirographOpenApiClient.DocumentName)</_ChirographOpenApiDocumentName>
      <_ChirographOpenApiClientIdentity>%(_ChirographOpenApiClient.Identity)</_ChirographOpenApiClientIdentity>
      <_ChirographOpenApiServerPath Condition="'$(_ChirographOpenApiKind)' == 'Project'">%(_ChirographOpenApiClient.FullPath)</_ChirographOpenApiServerPath>
    </PropertyGroup>

    <!--
        a project: the documents Microsoft.Extensions.ApiDescription.Server writes from the project, which was built first as a project
        reference. GenerateOpenApiDocuments is asked for explicitly (it is incremental on the server's assembly): its own hook on Build only
        runs in some builds of a server with several target frameworks.
    -->
    <ItemGroup Condition="'$(_ChirographOpenApiKind)' == 'Project'">
      <_ChirographOpenApiServerReference Remove="@(_ChirographOpenApiServerReference)" />
      <_ChirographOpenApiServerReference
        Include="@(_MSBuildProjectReferenceExistent)"
        Condition="'%(_MSBuildProjectReferenceExistent.ChirographOpenApiClientServer)' == 'true' and '%(FullPath)' == '$(_ChirographOpenApiServerPath)'"
      />
    </ItemGroup>
    <MSBuild
      Condition="'$(_ChirographOpenApiKind)' == 'Project'"
      Projects="@(_ChirographOpenApiServerReference)"
      Targets="GenerateOpenApiDocuments;OpenApiGetDocuments"
      Properties="%(_ChirographOpenApiServerReference.SetConfiguration);%(_ChirographOpenApiServerReference.SetPlatform)"
      RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;%(_ChirographOpenApiServerReference.GlobalPropertiesToRemove)"
    >
      <Output TaskParameter="TargetOutputs" ItemName="_ChirographOpenApiServerDocument" />
    </MSBuild>
    <ItemGroup Condition="'$(_ChirographOpenApiKind)' == 'Project'">
      <!-- ASP.NET Core's default document, v1, is <Project>.json; any other is <Project>_<name>.json -->
      <_ChirographOpenApiChosenDocument
        Include="@(_ChirographOpenApiServerDocument)"
        Condition="'$(_ChirographOpenApiDocumentName)' == '' or ('$(_ChirographOpenApiDocumentName)' == 'v1' and !$([System.String]::Copy('%(Filename)').Contains('_'))) or $([System.String]::Copy('%(Filename)').EndsWith('_$(_ChirographOpenApiDocumentName)'))"
      />
    </ItemGroup>
    <Error
      Condition="'$(_ChirographOpenApiKind)' == 'Project' and '@(_ChirographOpenApiChosenDocument->Count())' != '1'"
      Code="CHIRO103"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro103"
      Text="The project '$(_ChirographOpenApiClientIdentity)' of the OpenApiClient '$(_ChirographOpenApiClientName)' wrote the documents '@(_ChirographOpenApiServerDocument)': set DocumentName to the one the client is generated from."
    />
    <PropertyGroup Condition="'$(_ChirographOpenApiKind)' == 'Project'">
      <_ChirographOpenApiSource>@(_ChirographOpenApiChosenDocument->'%(FullPath)')</_ChirographOpenApiSource>
    </PropertyGroup>

    <!--
        a URL: kept in a cache, which is DocumentCache when the client names one (a file in the project, which can be committed) or else
        the copy in obj. The document is downloaded on every build and the cache updated, unless UpdateDocumentCache is false and the
        cache exists: then the cache is used as it is, so a change to the API reaches the client only when the cache is deleted or updated
        on purpose. When the download fails, the cache stands in for it with a warning.
    -->
    <PropertyGroup Condition="'$(_ChirographOpenApiKind)' == 'Url'">
      <_ChirographOpenApiDownloadDirectory>%(_ChirographOpenApiClient.ClientDirectory)download/</_ChirographOpenApiDownloadDirectory>
      <_ChirographOpenApiCache>%(_ChirographOpenApiClient.DocumentCache)</_ChirographOpenApiCache>
      <_ChirographOpenApiCache Condition="'$(_ChirographOpenApiCache)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_ChirographOpenApiCache)'))</_ChirographOpenApiCache>
      <_ChirographOpenApiCache Condition="'$(_ChirographOpenApiCache)' == ''">$(_ChirographOpenApiDocument)</_ChirographOpenApiCache>
      <_ChirographOpenApiUpdateCache>%(_ChirographOpenApiClient.UpdateDocumentCache)</_ChirographOpenApiUpdateCache>
      <_ChirographOpenApiUpdateCache Condition="'$(_ChirographOpenApiUpdateCache)' == ''">$(ChirographUpdateOpenApiDocumentCache)</_ChirographOpenApiUpdateCache>
      <_ChirographOpenApiDownload>true</_ChirographOpenApiDownload>
      <_ChirographOpenApiDownload Condition="'$(_ChirographOpenApiUpdateCache)' == 'false' and Exists('$(_ChirographOpenApiCache)')">false</_ChirographOpenApiDownload>
      <_ChirographOpenApiDownloaded>$(_ChirographOpenApiDownloadDirectory)openapi%(_ChirographOpenApiClient.DocumentExtension)</_ChirographOpenApiDownloaded>
    </PropertyGroup>
    <RemoveDir Condition="'$(_ChirographOpenApiKind)' == 'Url' and '$(_ChirographOpenApiDownload)' == 'true'" Directories="$(_ChirographOpenApiDownloadDirectory)" />
    <DownloadFile
      Condition="'$(_ChirographOpenApiKind)' == 'Url' and '$(_ChirographOpenApiDownload)' == 'true'"
      SourceUrl="$(_ChirographOpenApiClientIdentity)"
      DestinationFolder="$(_ChirographOpenApiDownloadDirectory)"
      DestinationFileName="openapi%(_ChirographOpenApiClient.DocumentExtension)"
      SkipUnchangedFiles="false"
      Retries="2"
      ContinueOnError="true"
    />
    <Warning
      Condition="'$(_ChirographOpenApiKind)' == 'Url' and '$(_ChirographOpenApiDownload)' == 'true' and !Exists('$(_ChirographOpenApiDownloaded)') and Exists('$(_ChirographOpenApiCache)')"
      Code="CHIRO104"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro104"
      Text="The OpenAPI document of the OpenApiClient '$(_ChirographOpenApiClientName)' could not be downloaded from '$(_ChirographOpenApiClientIdentity)': the client is generated from the cached copy, '$(_ChirographOpenApiCache)'."
    />
    <Error
      Condition="'$(_ChirographOpenApiKind)' == 'Url' and !Exists('$(_ChirographOpenApiDownloaded)') and !Exists('$(_ChirographOpenApiCache)')"
      Code="CHIRO105"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro105"
      Text="The OpenAPI document of the OpenApiClient '$(_ChirographOpenApiClientName)' could not be downloaded from '$(_ChirographOpenApiClientIdentity)', and there is no cached copy."
    />
    <!-- a download updates the cache when it differs from it -->
    <GetFileHash Condition="'$(_ChirographOpenApiKind)' == 'Url' and Exists('$(_ChirographOpenApiDownloaded)')" Files="$(_ChirographOpenApiDownloaded)">
      <Output TaskParameter="Hash" PropertyName="_ChirographOpenApiDownloadedHash" />
    </GetFileHash>
    <GetFileHash
      Condition="'$(_ChirographOpenApiKind)' == 'Url' and Exists('$(_ChirographOpenApiDownloaded)') and Exists('$(_ChirographOpenApiCache)')"
      Files="$(_ChirographOpenApiCache)"
    >
      <Output TaskParameter="Hash" PropertyName="_ChirographOpenApiCacheHash" />
    </GetFileHash>
    <Copy
      Condition="'$(_ChirographOpenApiKind)' == 'Url' and Exists('$(_ChirographOpenApiDownloaded)') and '$(_ChirographOpenApiDownloadedHash)' != '$(_ChirographOpenApiCacheHash)'"
      SourceFiles="$(_ChirographOpenApiDownloaded)"
      DestinationFiles="$(_ChirographOpenApiCache)"
    />
    <PropertyGroup Condition="'$(_ChirographOpenApiKind)' == 'Url'">
      <_ChirographOpenApiSource>$(_ChirographOpenApiCache)</_ChirographOpenApiSource>
    </PropertyGroup>

    <!-- copied when its content differs from the copy -->
    <GetFileHash Condition="Exists('$(_ChirographOpenApiSource)')" Files="$(_ChirographOpenApiSource)">
      <Output TaskParameter="Hash" PropertyName="_ChirographOpenApiSourceHash" />
    </GetFileHash>
    <GetFileHash Condition="Exists('$(_ChirographOpenApiDocument)')" Files="$(_ChirographOpenApiDocument)">
      <Output TaskParameter="Hash" PropertyName="_ChirographOpenApiDocumentHash" />
    </GetFileHash>
    <Copy
      Condition="Exists('$(_ChirographOpenApiSource)') and '$(_ChirographOpenApiSourceHash)' != '$(_ChirographOpenApiDocumentHash)'"
      SourceFiles="$(_ChirographOpenApiSource)"
      DestinationFiles="$(_ChirographOpenApiDocument)"
    />

    <PropertyGroup>
      <_ChirographOpenApiSourceHash />
      <_ChirographOpenApiDocumentHash />
      <_ChirographOpenApiKind />
      <_ChirographOpenApiClientName />
      <_ChirographOpenApiClientIdentity />
      <_ChirographOpenApiDownloadDirectory />
      <_ChirographOpenApiCache />
      <_ChirographOpenApiUpdateCache />
      <_ChirographOpenApiDownload />
      <_ChirographOpenApiDownloaded />
      <_ChirographOpenApiDownloadedHash />
      <_ChirographOpenApiCacheHash />
      <_ChirographOpenApiDocumentName />
      <_ChirographOpenApiServerPath />
    </PropertyGroup>
    <ItemGroup>
      <_ChirographOpenApiServerDocument Remove="@(_ChirographOpenApiServerDocument)" />
      <_ChirographOpenApiChosenDocument Remove="@(_ChirographOpenApiChosenDocument)" />
    </ItemGroup>
  </Target>

  <!--
      Writes what a client is generated with, only when it changed (so its time stamp tells when it did), the settings file of Refitter,
      and the registration of the client.
  -->
  <Target Name="_ChirographWriteOpenApiClientSettings" DependsOnTargets="_ChirographFindOpenApiTools">
    <ItemGroup>
      <_ChirographOpenApiClient>
        <ToolVersion Condition="'%(_ChirographOpenApiClient.Generator)' == 'Kiota'">$(_ChirographKiotaToolVersion)</ToolVersion>
        <ToolVersion Condition="'%(_ChirographOpenApiClient.Generator)' == 'Refitter'">$(_ChirographRefitterToolVersion)</ToolVersion>
      </_ChirographOpenApiClient>
    </ItemGroup>
    <WriteLinesToFile
      File="%(_ChirographOpenApiClient.SettingsFile)"
      Lines="Generator=%(_ChirographOpenApiClient.Generator);Version=%(_ChirographOpenApiClient.ToolVersion);ClientName=%(_ChirographOpenApiClient.ClientName);Namespace=%(_ChirographOpenApiClient.Namespace);Options=$([MSBuild]::Escape('%(_ChirographOpenApiClient.Options)'))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <WriteLinesToFile
      Condition="'%(_ChirographOpenApiClient.Generator)' == 'Refitter'"
      File="%(_ChirographOpenApiClient.RefitterSettingsFile)"
      Lines="{ &quot;openApiPath&quot;: &quot;$([System.String]::Copy('%(_ChirographOpenApiClient.Document)').Replace('\', '/'))&quot;, &quot;namespace&quot;: &quot;%(_ChirographOpenApiClient.Namespace)&quot;, &quot;naming&quot;: { &quot;useOpenApiTitle&quot;: false, &quot;interfaceName&quot;: &quot;%(_ChirographOpenApiClient.ClientName)&quot; }, &quot;useCancellationTokens&quot;: true }"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <_ChirographOpenApiClientRegistration Remove="@(_ChirographOpenApiClientRegistration)" />
      <_ChirographOpenApiClientRegistration
        Include="@(_ChirographOpenApiClient->'%(RegistrationFile)')"
        Text="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)templates/%(Generator)Registration.cs.template').Replace('__Namespace__', '%(Namespace)').Replace('__ClientName__', '%(ClientName)').Replace('__ChirographVersion__', '$(ChirographVersion)'))"
      />
    </ItemGroup>
    <WriteLinesToFile
      File="%(_ChirographOpenApiClientRegistration.Identity)"
      Lines="$([MSBuild]::Escape('%(_ChirographOpenApiClientRegistration.Text)'))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
  </Target>

  <!--
      The generator tools, in the packages folders restore uses (the packages folder, or a fallback folder), at the version the SDK was
      packed with, or else the version Directory.Packages.props pins (Chirograph's own repository can import this file directly).
  -->
  <Target Name="_ChirographFindOpenApiTools">
    <PropertyGroup>
      <_ChirographKiotaToolVersion>$(ChirographKiotaVersion)</_ChirographKiotaToolVersion>
      <_ChirographKiotaToolVersion Condition="'$(_ChirographKiotaToolVersion)' == ''">@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.OpenApi.Kiota')->'%(Version)')</_ChirographKiotaToolVersion>
      <_ChirographRefitterToolVersion>$(ChirographRefitterVersion)</_ChirographRefitterToolVersion>
      <_ChirographRefitterToolVersion Condition="'$(_ChirographRefitterToolVersion)' == ''">@(PackageVersion->WithMetadataValue('Identity', 'Refitter')->'%(Version)')</_ChirographRefitterToolVersion>
    </PropertyGroup>
    <ItemGroup>
      <_ChirographPackageFolder Remove="@(_ChirographPackageFolder)" />
      <_ChirographPackageFolder Include="$(NuGetPackageFolders);$(NuGetPackageRoot)" />
      <_ChirographOpenApiToolCandidate Remove="@(_ChirographOpenApiToolCandidate)" />
      <_ChirographOpenApiToolCandidate
        Include="@(_ChirographPackageFolder->'%(Identity)/microsoft.openapi.kiota/$(_ChirographKiotaToolVersion)/tools/$(_ChirographOpenApiToolFramework)/any/kiota.dll')"
        Generator="Kiota"
      />
      <_ChirographOpenApiToolCandidate
        Include="@(_ChirographPackageFolder->'%(Identity)/refitter/$(_ChirographRefitterToolVersion)/tools/$(_ChirographOpenApiToolFramework)/any/refitter.dll')"
        Generator="Refitter"
      />
      <_ChirographOpenApiTool Remove="@(_ChirographOpenApiTool)" />
      <_ChirographOpenApiTool Include="@(_ChirographOpenApiToolCandidate)" Condition="Exists('%(_ChirographOpenApiToolCandidate.Identity)')" />
    </ItemGroup>
    <PropertyGroup>
      <_ChirographKiotaToolPath>@(_ChirographOpenApiTool->WithMetadataValue('Generator', 'Kiota')->'%(FullPath)'->Distinct())</_ChirographKiotaToolPath>
      <_ChirographKiotaToolPath>$(_ChirographKiotaToolPath.Split(';')[0])</_ChirographKiotaToolPath>
      <_ChirographRefitterToolPath>@(_ChirographOpenApiTool->WithMetadataValue('Generator', 'Refitter')->'%(FullPath)'->Distinct())</_ChirographRefitterToolPath>
      <_ChirographRefitterToolPath>$(_ChirographRefitterToolPath.Split(';')[0])</_ChirographRefitterToolPath>
      <_ChirographOpenApiDotnet>$(DOTNET_HOST_PATH)</_ChirographOpenApiDotnet>
      <_ChirographOpenApiDotnet Condition="'$(_ChirographOpenApiDotnet)' == ''">dotnet</_ChirographOpenApiDotnet>
    </PropertyGroup>
  </Target>

  <!-- Generates a client when its document or its settings changed since it was last generated. Batched on each client. -->
  <Target
    Name="_ChirographRunOpenApiClientGenerators"
    Inputs="%(_ChirographOpenApiClient.Document);%(_ChirographOpenApiClient.SettingsFile)"
    Outputs="%(_ChirographOpenApiClient.StampFile)"
  >
    <PropertyGroup>
      <_ChirographOpenApiGenerator>%(_ChirographOpenApiClient.Generator)</_ChirographOpenApiGenerator>
      <_ChirographOpenApiToolPath Condition="'$(_ChirographOpenApiGenerator)' == 'Kiota'">$(_ChirographKiotaToolPath)</_ChirographOpenApiToolPath>
      <_ChirographOpenApiToolPath Condition="'$(_ChirographOpenApiGenerator)' == 'Refitter'">$(_ChirographRefitterToolPath)</_ChirographOpenApiToolPath>
      <_ChirographOpenApiGeneratedDirectory>%(_ChirographOpenApiClient.GeneratedDirectory)</_ChirographOpenApiGeneratedDirectory>
      <!-- the tools run on the newest runtime installed when .NET 10 is not -->
      <_ChirographOpenApiCommand>&quot;$(_ChirographOpenApiDotnet)&quot; exec --roll-forward Major &quot;$(_ChirographOpenApiToolPath)&quot;</_ChirographOpenApiCommand>
      <_ChirographOpenApiCommand Condition="'$(_ChirographOpenApiGenerator)' == 'Kiota'">$(_ChirographOpenApiCommand) generate --language CSharp --openapi &quot;%(_ChirographOpenApiClient.Document)&quot; --class-name %(_ChirographOpenApiClient.ClientName) --namespace-name %(_ChirographOpenApiClient.Namespace) --output &quot;$(_ChirographOpenApiGeneratedDirectory.TrimEnd('/'))&quot; --clean-output --exclude-backward-compatible --log-level Warning %(_ChirographOpenApiClient.Options)</_ChirographOpenApiCommand>
      <_ChirographOpenApiCommand Condition="'$(_ChirographOpenApiGenerator)' == 'Refitter'">$(_ChirographOpenApiCommand) --settings-file &quot;%(_ChirographOpenApiClient.RefitterSettingsFile)&quot; --output &quot;$(_ChirographOpenApiGeneratedDirectory)%(_ChirographOpenApiClient.ClientName).cs&quot; --no-logging --no-banner --simple-output %(_ChirographOpenApiClient.Options)</_ChirographOpenApiCommand>
    </PropertyGroup>
    <Error
      Condition="'$(_ChirographOpenApiToolPath)' == ''"
      Code="CHIRO106"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro106"
      Text="The $(_ChirographOpenApiGenerator) tool the OpenApiClient '%(_ChirographOpenApiClient.ClientName)' is generated with was not found in the packages folders ($(NuGetPackageFolders)): restore the project."
    />

    <Message Importance="high" Text="Generating the OpenAPI client %(_ChirographOpenApiClient.ClientName) with $(_ChirographOpenApiGenerator)" />
    <RemoveDir Directories="$(_ChirographOpenApiGeneratedDirectory)" />
    <MakeDir Directories="$(_ChirographOpenApiGeneratedDirectory)" />
    <!--
        No telemetry and no update checks: a build is not a place to call home. Kiota reads KIOTA_CLI_TELEMETRY_OPTOUT, and
        KIOTA_OFFLINE_ENABLED turns its update check off. What the tools write is logged, not parsed for warnings (Kiota warns about every
        document without a server); when a tool fails, the build fails with what it wrote.
    -->
    <Exec
      Command="$(_ChirographOpenApiCommand)"
      WorkingDirectory="%(_ChirographOpenApiClient.ClientDirectory)"
      EnvironmentVariables="KIOTA_CLI_TELEMETRY_OPTOUT=true;KIOTA_OFFLINE_ENABLED=true;DOTNET_CLI_TELEMETRY_OPTOUT=1"
      IgnoreStandardErrorWarningFormat="true"
      IgnoreExitCode="true"
      ConsoleToMSBuild="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
    >
      <Output TaskParameter="ExitCode" PropertyName="_ChirographOpenApiExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_ChirographOpenApiOutput" />
    </Exec>
    <Error
      Condition="'$(_ChirographOpenApiExitCode)' != '0'"
      Code="CHIRO107"
      HelpLink="$(_ChirographDiagnosticsUrl)#chiro107"
      Text="$(_ChirographOpenApiGenerator) could not generate the OpenAPI client %(_ChirographOpenApiClient.ClientName) (exit code $(_ChirographOpenApiExitCode)):%0A@(_ChirographOpenApiOutput, '%0A')"
    />
    <ItemGroup>
      <_ChirographOpenApiOutput Remove="@(_ChirographOpenApiOutput)" />
    </ItemGroup>
    <Touch Files="%(_ChirographOpenApiClient.StampFile)" AlwaysCreate="true" />
  </Target>

  <!-- Adds the code of every client generated so far, and its registration, to the compilation. -->
  <Target Name="_ChirographCompileOpenApiClients" DependsOnTargets="_ChirographPrepareOpenApiClients">
    <ItemGroup>
      <_ChirographOpenApiClientCode Remove="@(_ChirographOpenApiClientCode)" />
      <_ChirographOpenApiClientCode Include="%(_ChirographOpenApiClient.GeneratedDirectory)**/*.cs" />
      <_ChirographOpenApiClientCode Include="@(_ChirographOpenApiClient->'%(RegistrationFile)')" Condition="Exists('%(_ChirographOpenApiClient.RegistrationFile)')" />
      <Compile Include="@(_ChirographOpenApiClientCode)" />
      <FileWrites Include="@(_ChirographOpenApiClientCode)" />
      <!-- the stamp goes with the code dotnet clean removes, so the next build generates the client again -->
      <FileWrites Include="@(_ChirographOpenApiClient->'%(StampFile)')" Condition="Exists('%(_ChirographOpenApiClient.StampFile)')" />
    </ItemGroup>
  </Target>
</Project>
