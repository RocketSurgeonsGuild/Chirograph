<Project>
  <!--
      Imported at the end of the project, so the files below see the project's own items. Chirograph.ImplicitPackageReferences.targets
      comes last: it expands the _ChirographImplicitPackageReference items every file before it declares.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Chirograph.ImplicitPackageReferences.targets" />
</Project>
