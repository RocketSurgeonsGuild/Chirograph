<Project Sdk="Microsoft.NET.Sdk">
  <!--
      The Chirograph MSBuild SDK: a project applies it next to its own SDK with <Sdk Name="Chirograph" />. It ships MSBuild files only
      (Sdk/**) and no assembly. The target framework only gives pack something to evaluate.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- NU5128: there is no lib/ folder to match the dependency groups, because the package has no build output. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageType>MSBuildSdk</PackageType>
    <NoBuildOutput>true</NoBuildOutput>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Nothing to compare: package validation looks at assemblies, and there are none. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageDescription>MSBuild SDK that generates typed HTTP clients from OpenAPI documents at build time, with Kiota or Refitter, and registers them with IHttpClientFactory.</PackageDescription>
    <PackageTags>$(PackageTags);msbuild-sdk;msbuild;kiota;refitter;refit;httpclient;rest-client;codegen</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Sdk/**" />
    <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
    <Using Remove="**" />
  </ItemGroup>
  <Import Project="Chirograph.Pack.targets" />
</Project>
