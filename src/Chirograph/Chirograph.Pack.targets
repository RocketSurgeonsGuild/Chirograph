<Project>
  <!--
      Writes Sdk/Packages.props into the package, which Sdk/Sdk.props imports: ChirographVersion, the version of the SDK, and the versions
      Directory.Packages.props pins for the two generator tools (Microsoft.OpenApi.Kiota and Refitter, downloaded with PackageDownload)
      and the packages their clients need (Microsoft.Kiota.Bundle, Refit.HttpClientFactory and Microsoft.Extensions.Http,
      Duende.AccessTokenManagement for the ClientCredentials authentication, and Azure.Identity for the Azure ones). The versions are only
      known when the SDK is packed, so the file is generated then rather than kept in the repository. A consumer can set any of them first
      to choose another.

      This project targets netstandard2.0, so a pin split per release train (Microsoft.Extensions.Http) resolves to the one below net11.0,
      which every supported target framework can use.
  -->
  <Target Name="_ChirographGeneratePackagesProps" BeforeTargets="_GetPackageFiles;Pack">
    <ItemGroup>
      <_ChirographPinnedPackage Include="@(PackageVersion)" Condition="'%(Identity)' == 'Microsoft.OpenApi.Kiota'" Property="ChirographKiotaVersion" />
      <_ChirographPinnedPackage Include="@(PackageVersion)" Condition="'%(Identity)' == 'Refitter'" Property="ChirographRefitterVersion" />
      <_ChirographPinnedPackage Include="@(PackageVersion)" Condition="'%(Identity)' == 'Microsoft.Kiota.Bundle'" Property="ChirographKiotaBundleVersion" />
      <_ChirographPinnedPackage Include="@(PackageVersion)" Condition="'%(Identity)' == 'Refit.HttpClientFactory'" Property="ChirographRefitVersion" />
      <_ChirographPinnedPackage Include="@(PackageVersion)" Condition="'%(Identity)' == 'Microsoft.Extensions.Http'" Property="ChirographMicrosoftExtensionsHttpVersion" />
      <_ChirographPinnedPackage Include="@(PackageVersion)" Condition="'%(Identity)' == 'Duende.AccessTokenManagement'" Property="ChirographDuendeAccessTokenManagementVersion" />
      <_ChirographPinnedPackage Include="@(PackageVersion)" Condition="'%(Identity)' == 'Azure.Identity'" Property="ChirographAzureIdentityVersion" />
    </ItemGroup>
    <PropertyGroup>
      <_ChirographPackagesProps>$(IntermediateOutputPath)Packages.props</_ChirographPackagesProps>
    </PropertyGroup>
    <Error
      Condition="'@(_ChirographPinnedPackage->Count())' != '7'"
      Text="Directory.Packages.props pins one version of each of Microsoft.OpenApi.Kiota, Refitter, Microsoft.Kiota.Bundle, Refit.HttpClientFactory, Microsoft.Extensions.Http, Duende.AccessTokenManagement and Azure.Identity, which $(PackageId) writes into Sdk/Packages.props: found @(_ChirographPinnedPackage)."
    />
    <ItemGroup>
      <!-- %24 is $ and %27 is ': the file reads the consumer's properties, which must not be expanded here -->
      <_ChirographPackagesPropsLine Include="&lt;Project&gt;" />
      <_ChirographPackagesPropsLine Include="&lt;!-- Generated when $(PackageId) is packed. Each version is only set when the project has not set it already. --&gt;" />
      <_ChirographPackagesPropsLine Include="&lt;PropertyGroup&gt;" />
      <_ChirographPackagesPropsLine Include="&lt;ChirographVersion Condition=&quot;%27%24(ChirographVersion)%27 == %27%27&quot;&gt;$(PackageVersion)&lt;/ChirographVersion&gt;" />
      <_ChirographPackagesPropsLine Include="@(_ChirographPinnedPackage->'&lt;%(Property) Condition=&quot;%27%24(%(Property))%27 == %27%27&quot;&gt;%(Version)&lt;/%(Property)&gt;')" />
      <_ChirographPackagesPropsLine Include="&lt;/PropertyGroup&gt;" />
      <_ChirographPackagesPropsLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_ChirographPackagesProps)" Lines="@(_ChirographPackagesPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_ChirographPackagesProps)" Pack="true" PackagePath="Sdk" />
      <FileWrites Include="$(_ChirographPackagesProps)" />
    </ItemGroup>
  </Target>
</Project>
