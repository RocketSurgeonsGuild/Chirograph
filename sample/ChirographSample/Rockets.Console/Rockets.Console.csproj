<!--
    A console app that uses both clients, without Dovetail: Program.cs calls the generated Add<ClientName>() registrations on a
    plain Host.CreateApplicationBuilder. It declares no OpenApiClient itself, so it doesn't need Chirograph.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../Rockets.Client.Kiota/Rockets.Client.Kiota.csproj" />
    <ProjectReference Include="../Rockets.Client.Refitter/Rockets.Client.Refitter.csproj" />
  </ItemGroup>
</Project>
