<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.CI" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.GlobalAnalyzerConfig" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.GitVersion" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.SourceLink" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <GlobalPackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="11.0.100" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="5.0.1" />
    <GlobalPackageReference Include="ZeroAlloc.Analyzers" Version="1.13.0" />
    <GlobalPackageReference Include="Spectre.Console.Analyzer" Version="1.0.0" />
    <GlobalPackageReference Include="JetBrains.ExternalAnnotations" Version="10.2.172" />
    <GlobalPackageReference Include="JetBrains.Annotations.Sources" Version="2026.2.0" />
  </ItemGroup>
  <ItemGroup Label="Build host">
    <!-- build/Build.cs, the ModularPipelines file-based app behind `mise run build`. -->
    <PackageVersion Include="Rocket.Surgery.ModularPipelines.Extensions" Version="0.2.3" />
    <!-- The build host references the published Dovetail and Specular generators directly, as Rocket.Surgery.ModularPipelines.Extensions requires; they write ConfigureDovetail and the module scan into it. -->
    <PackageVersion Include="Joinery.Dovetail.ModularPipelines" Version="0.5.3" />
    <PackageVersion Include="Specular" Version="0.4.1" />
    <!-- ModularPipelines 4 targets net11.0 only. -->
    <PackageVersion Include="ModularPipelines" Version="4.0.0" />
    <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
    <PackageVersion Include="Sourcy.Git" Version="1.1.1" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
  </ItemGroup>
  <ItemGroup Label="OpenAPI generators">
    <!--
        The generator tools Chirograph downloads (PackageDownload) and the runtime packages their clients need. Chirograph's pack
        writes these versions into Sdk/Packages.props. Renovate moves them as one group ("openapi generators").
    -->
    <PackageVersion Include="Microsoft.OpenApi.Kiota" Version="1.38.0" />
    <PackageVersion Include="Microsoft.Kiota.Bundle" Version="2.1.6" />
    <PackageVersion Include="Refitter" Version="2.3.1" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.4.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="MSBuild.ProjectCreation" Version="20.0.0" />
    <!-- The MSBuild packages Chirograph.Tests compiles against (MSBuild.ProjectCreation brings Microsoft.Build); keep all three on one version. -->
    <PackageVersion Include="Microsoft.Build" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    <PackageVersion Include="MSBuild.StructuredLogger.Utils" Version="2.3.269" />
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" />
    <!-- NuGet.Packaging pulls the vulnerable 8.0.1 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.TUnit" Version="11.0.1" />
    <PackageVersion Include="TUnit" Version="1.85.0" />
    <PackageVersion Include="TUnit.Mocks" Version="1.85.0" />
    <PackageVersion Include="TUnit.Assertions.Should" Version="1.85.0-beta" />
    <PackageVersion Include="Verify.TUnit" Version="33.4.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
  </ItemGroup>
  <!-- The client runtime and server packages follow the target framework's release train: the tests build consumers on both. -->
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
  </ItemGroup>
</Project>
